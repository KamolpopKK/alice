# Copy to .env (never commit .env)
# Server image version (ghcr.io/kamolpopkk/alice); change it to upgrade or roll back
ALICE_VERSION=0.2.5
ALICE_PUBLIC_URL=http://localhost:8080
# Generate with: openssl rand -hex 24
ALICE_BOOTSTRAP_TOKEN=

# Automatic HTTPS (docker compose --profile https up -d): your domain, pointing at this host
# ALICE_DOMAIN=alice.example.com
# ALICE_PUBLIC_URL=https://alice.example.com
# ALICE_TRUST_PROXY=true
