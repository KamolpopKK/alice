{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The Alice UI may call only Alice's own native commands and listen to their events. No shell, filesystem, HTTP or opener access is granted to the WebView.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-profiles-list",
    "allow-profile-add",
    "allow-profile-remove",
    "allow-profile-use",
    "allow-profile-test",
    "allow-auth-status",
    "allow-auth-login-start",
    "allow-auth-login-cancel",
    "allow-auth-logout",
    "allow-api-request",
    "allow-events-subscribe",
    "allow-events-unsubscribe",
    "allow-open-external",
    "allow-deeplink-take",
    "allow-update-check",
    "allow-update-install",
    "allow-capture-take",
    "allow-shortcuts-get",
    "allow-shortcuts-set",
    "allow-shortcuts-reset",
    "allow-local-first-run",
    "allow-workspace-create",
    "allow-workspace-rename",
    "allow-workspace-alias",
    "allow-owner-rename",
    "allow-local-open-folder",
    "allow-local-restore-latest",
    "allow-local-diagnostics",
    "allow-tools-apply",
    "allow-integrations-status",
    "allow-integration-set",
    "allow-integration-unassign",
    "allow-editor-dirty-set",
    "allow-editor-leave-reply"
  ]
}
